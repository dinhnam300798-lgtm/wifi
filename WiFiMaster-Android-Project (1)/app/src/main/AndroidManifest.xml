<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.wifimaster.hardwaremonitor">

    <!-- Basic Network & Internet Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Wi-Fi State Permissions -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- 
      CRITICAL FOR ANDROID 10+ (API 29+) & 14+: 
      ACCESS_FINE_LOCATION is MANDATORY to read SSID, BSSID, and Wi-Fi scan results.
      Without Fine Location, WifiInfo returns "<unknown ssid>" and "02:00:00:00:00:00".
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 
      Android 13+ (API 33+) Nearby Devices Permission:
      Allows discovering nearby Wi-Fi endpoints. Note: if neverForLocation is set,
      location cannot be derived, but reading current connection SSID still requires FINE_LOCATION.
    -->
    <uses-permission 
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- Android 13+ Notification Permission for Background Monitor -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 14+ (API 34) Foreground Service Types -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Wi-Fi hardware requirement flag (graceful fallback on devices without Wi-Fi) -->
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="true" />

    <application
        android:name=".WifiMasterApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WifiMaster"
        tools:targetApi="34">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WifiMaster">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Continuous background signal & connection monitor service -->
        <service
            android:name=".service.WifiMonitorForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

    </application>
</manifest>